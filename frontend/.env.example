# Backend API URL Configuration
# ================================

# For LOCAL DEVELOPMENT (default):
REACT_APP_API_URL=http://localhost:3001/api

# For PRODUCTION TESTING (Railway backend):
# REACT_APP_API_URL=https://spl-token-backend-production.up.railway.app/api

# Note:
# - .env is used for local development (npm start)
# - .env.production is automatically used for production builds (npm run build)
# - Simply uncomment/comment the appropriate line above to switch
